{
  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";
    flake-utils.url = "github:numtide/flake-utils";
    rust-overlay = {
      url = "github:oxalica/rust-overlay";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    crane.url = "github:ipetkov/crane";
  };

  outputs =
    { self
    , nixpkgs
    , flake-utils
    , rust-overlay
    , crane
    ,
    }:
    flake-utils.lib.eachDefaultSystem (
      system:
      let
        overlays = [ (import rust-overlay) ];
        pkgs = import nixpkgs { inherit system overlays; };

        lib = nixpkgs.lib;

        # One rust-overlay toolchain for rustc, cargo, rustfmt and clippy.
        rustToolchain = pkgs.rust-bin.stable.latest.default;
        craneLib = (crane.mkLib pkgs).overrideToolchain rustToolchain;

        src = lib.cleanSourceWith { src = craneLib.path ./.; };

        envVars = lib.attrsets.optionalAttrs pkgs.stdenv.hostPlatform.isLinux {
          RUSTFLAGS = "-Clinker=clang -Clink-arg=--ld-path=${pkgs.mold}/bin/mold";
        };

        # rusqlite uses the bundled feature, so it needs only a C compiler.
        commonArgs = {
          inherit src;
          strictDeps = true;
          nativeBuildInputs = [ pkgs.clang ];
          buildInputs = lib.optionals pkgs.stdenv.hostPlatform.isDarwin [ pkgs.libiconv ];
        } // envVars;

        cargoArtifacts = craneLib.buildDepsOnly commonArgs;

        scree = craneLib.buildPackage (commonArgs // {
          inherit cargoArtifacts;
          doCheck = false; # nextest runs in checks.nextest
        });

        # SKILL.md generated by this build; fails if --check disagrees.
        skill = pkgs.runCommand "scree-skill" { } ''
          mkdir -p $out
          ${scree}/bin/scree skill > $out/SKILL.md
          ${scree}/bin/scree skill --check $out/SKILL.md
        '';

        # The Herdr mod (herdr/scree/mods/scree), laid out as a Herdr home's mods/ folder so
        # another flake can link $out/mods/scree into ~/.config/herdr-app/mods/. The mod's
        # scree binary is pinned to this flake's package. The node test of the mod's pure
        # helpers and click-path guards runs first, so a broken mod fails the build.
        herdr-mod = pkgs.runCommand "scree-herdr-mod" { nativeBuildInputs = [ pkgs.nodejs ]; } ''
          mkdir -p $out/mods
          cp -r ${./herdr/scree/mods/scree} $out/mods/scree
          chmod -R u+w $out/mods/scree
          node $out/mods/scree/scree.test.mjs
          substituteInPlace $out/mods/scree/main.js --replace-fail "@scree@" "${scree}/bin/scree"
        '';
      in
      {
        packages = {
          default = scree;
          inherit skill herdr-mod;
        };

        checks = {
          build = scree;
          inherit herdr-mod;
          clippy = craneLib.cargoClippy (commonArgs // {
            inherit cargoArtifacts;
            cargoClippyExtraArgs = "--all-targets -- -D warnings";
          });
          fmt = craneLib.cargoFmt { inherit src; };
          nextest = craneLib.cargoNextest (commonArgs // {
            inherit cargoArtifacts;
            nativeCheckInputs = [ pkgs.git ];
          });
        };

        devShells.default = pkgs.mkShell ({
          packages = [
            rustToolchain
            pkgs.cargo-nextest
            pkgs.cargo-release
            pkgs.cargo-watch
            pkgs.clang
            pkgs.sqlite
          ] ++ lib.optionals pkgs.stdenv.hostPlatform.isLinux [ pkgs.mold ];
        } // envVars);

        formatter = pkgs.nixpkgs-fmt;
      }
    );
}
